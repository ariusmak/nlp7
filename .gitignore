# Raw data — reproducible from external sources, should not be committed
data/raw/
data/interim/
data/processed/

# Handoff dataset IS committed (minimum inputs for groupmates)
!data/handoff/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Outputs: figures and tables are committed; logs are not
outputs/logs/*
!outputs/logs/.gitkeep

# Env / IDE
.env
.venv/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
